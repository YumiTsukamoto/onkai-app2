/* ═════════════════════════════════════════════
   スタイル
   ═════════════════════════════════════════════ */
const CSS = `
.app{
  --cream:#FFF6E5; --paper:#FFFFFF; --sand:#FBEFDA;
  --ink:#3B2F26; --sub:#8D7C6A; --line:#E8DBC4;
  --orange:#F0983C; --amber:#F5C63D; --mint:#2FB5A4; --red:#E2453C;
  --sky:#D3E8F0; --wood:#EBBD75; --wood-2:#D69B45;
  font-family:"M PLUS Rounded 1c","Hiragino Maru Gothic ProN","Yu Gothic",sans-serif;
  background:var(--cream); color:var(--ink);
  min-height:100%; padding:16px 16px 36px; box-sizing:border-box;
  max-width:720px; margin:0 auto;
}
.app *{box-sizing:border-box}
.app button{font-family:inherit}
.app button:focus-visible{outline:3px solid var(--mint); outline-offset:3px}

/* ── トップ画面 ── */
.hero{padding:16px 4px 24px}
.hero-eyebrow{font-size:11px; letter-spacing:.2em; color:var(--sub); font-weight:800}
.hero-title{
  margin:8px 0 0; font-size:clamp(30px, 10.5vw, 44px); line-height:1.1;
  font-weight:800; letter-spacing:.01em; color:var(--ink); white-space:nowrap;
}
.hero-title::after{
  content:""; display:block; width:64px; height:6px; margin-top:12px;
  background:var(--orange); border-radius:3px;
}
.hero-score{margin-top:16px}
.hero-score-label{font-size:11px; letter-spacing:.16em; color:var(--sub); font-weight:800}
.hero-score-num{margin-left:10px; font-size:26px; font-weight:800; color:var(--orange)}
.cards{display:flex; flex-direction:column; gap:10px}
.card{
  display:flex; align-items:center; gap:14px; width:100%; text-align:left; cursor:pointer;
  padding:14px 16px; border-radius:18px; background:var(--paper);
  border:2px solid var(--line); color:var(--ink);
  box-shadow:0 3px 0 var(--line);
  transition:transform .14s ease, border-color .14s ease, box-shadow .14s ease;
}
.card:hover{transform:translateY(-2px); border-color:var(--orange); box-shadow:0 5px 0 #F3D6A8}
.card:active{transform:translateY(1px); box-shadow:0 1px 0 var(--line)}
.card-icon{width:40px; height:46px; flex:none}
.ico-line{fill:none; stroke:#D3DAE1; stroke-width:3}
.card-text{display:flex; flex-direction:column; gap:3px; flex:1; min-width:0}
.card-name{font-size:18px; font-weight:800}
.card-desc{font-size:12px; color:var(--sub)}
.card-go{font-size:26px; color:#C9BBA6; line-height:1}
.home-note{margin:22px 4px 0; font-size:12px; color:var(--sub); line-height:1.8}
.howto-btn{
  display:flex; align-items:center; justify-content:center; gap:8px;
  width:100%; margin-top:14px; padding:13px; cursor:pointer;
  background:transparent; border:2px dashed #D9C7A8; border-radius:999px;
  color:var(--sub); font-size:15px; font-weight:800;
}
.howto-btn:hover{border-color:var(--orange); color:var(--orange)}
.howto-mark{
  width:22px; height:22px; border-radius:50%; background:var(--orange); color:#FFFFFF;
  display:grid; place-items:center; font-size:14px; line-height:1;
}

/* ── おんぷカード ── */
.streak{display:flex; align-items:baseline; gap:10px; margin-bottom:12px}
.streak-label{font-size:11px; letter-spacing:.14em; color:var(--sub); font-weight:800}
.streak-num{font-size:22px; font-weight:800; color:var(--mint)}
.card-wrap{
  position:relative; background:var(--paper); border:2px solid var(--line); border-radius:18px;
  padding:26px 16px; display:grid; place-items:center; min-height:230px;
}
.card-staff{width:100%; max-width:330px; height:auto}
.staff-line{stroke:#3B2F26; stroke-width:0.9}
.clef{
  fill:#3B2F26;
  font-family:"Bravura","Noto Music","Segoe UI Symbol","Apple Symbols",serif;
}
.note-head{fill:#3B2F26}
.note-hole{fill:#FFFFFF}

/* ── あそびかた ── */
.steps{list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px}
.step{
  display:flex; gap:12px; align-items:flex-start;
  background:var(--paper); border:2px solid var(--line); border-radius:16px; padding:14px;
}
.step-num{
  width:28px; height:28px; flex:none; border-radius:50%;
  background:var(--amber); color:var(--ink);
  display:grid; place-items:center; font-size:15px; font-weight:800;
}
.step-text{display:flex; flex-direction:column; gap:4px; min-width:0}
.step-title{font-size:15px; font-weight:800; line-height:1.5}
.step-desc{font-size:12.5px; color:var(--sub); line-height:1.7}
.help-head{
  margin:26px 4px 12px; font-size:13px; font-weight:800; letter-spacing:.14em; color:var(--sub);
}
.help-list{display:flex; flex-direction:column; gap:8px}
.help-item{
  background:var(--paper); border:2px solid var(--line); border-radius:14px; padding:12px 14px;
  display:flex; flex-direction:column; gap:4px;
}
.help-name{font-size:15px; font-weight:800}
.help-body{font-size:12.5px; color:var(--sub); line-height:1.7}
.tips{margin:0; padding-left:20px; display:flex; flex-direction:column; gap:8px}
.tips li{font-size:13px; color:var(--sub); line-height:1.7}

/* ── ゲーム共通 ── */
.topbar{display:flex; align-items:center; gap:12px; padding:2px 0 14px}
.back{
  width:38px; height:38px; border-radius:50%; flex:none; cursor:pointer;
  background:var(--paper); border:2px solid var(--line); color:var(--ink);
  font-size:22px; line-height:1; padding-bottom:3px;
}
.topbar-title{flex:1; font-size:17px; font-weight:800; letter-spacing:.03em}
.topbar-score{font-size:22px; font-weight:800; color:var(--orange)}

.prog{display:flex; gap:5px; flex-wrap:wrap; margin-bottom:12px}
.slot{
  min-width:34px; padding:5px; border-radius:9px; text-align:center;
  font-size:15px; font-weight:800;
  background:var(--sand); color:#B5A491; border:2px solid var(--line);
  transition:background .25s ease, color .25s ease, transform .25s ease;
}
.slot.is-given{background:var(--paper); color:var(--ink); border-color:#C9B79B; border-style:dashed}
.slot.is-open{background:var(--amber); color:var(--ink); border-color:var(--amber); border-style:solid; transform:translateY(-2px)}

.stage{position:relative}
.stage.is-miss{animation:shake .4s ease}
@keyframes shake{
  0%,100%{transform:translateX(0)} 20%{transform:translateX(-9px)}
  40%{transform:translateX(8px)} 60%{transform:translateX(-5px)} 80%{transform:translateX(4px)}
}

/* ── ロケット ── */
.sky-wrap{
  background:linear-gradient(180deg, #CFE6F5 0%, #E7F2FA 55%, #FDF3E2 100%);
  border:2px solid var(--line); border-radius:18px; padding:14px;
  display:grid; place-items:center;
}
.sky{width:100%; max-width:300px; height:auto}
.sky-path{fill:none; stroke:#FFFFFF; stroke-width:2.6; stroke-dasharray:4 5; stroke-linecap:round; opacity:.9}
.pad{fill:#B9A98F}
.goal-star{fill:#E0E7ED; transition:fill .4s ease}
.goal-star.is-on{fill:var(--amber); animation:twinkle 1.2s ease-in-out infinite}
@keyframes twinkle{50%{opacity:.5}}
.cloud-body{transition:fill .3s ease}
.cloud-text{fill:#9AA6B2; font-size:7px; font-weight:800; transition:fill .3s ease}
.cloud.is-open .cloud-text{fill:#3A2E24}
.cloud.is-open .cloud-body{animation:popIn .38s cubic-bezier(.2,1.6,.4,1)}
@keyframes popIn{from{transform:scale(.7); transform-origin:center} to{transform:scale(1)}}
.rocket{transform-box:view-box; transform-origin:0 0; transition:transform .45s cubic-bezier(.4,.1,.3,1)}
.rk-body{fill:#E2453C}
.rk-win{fill:#FBF7EF}
.rk-fin{fill:#F0983C}
.rk-flame{fill:#F5CE3E; opacity:0}
.rk-flame.is-on{opacity:1; animation:flame .18s ease-in-out infinite alternate}
@keyframes flame{to{transform:scaleY(.6); transform-origin:center top}}

/* ── おはな ── */
.flower-wrap{
  background:var(--paper); border:2px solid var(--line); border-radius:18px;
  padding:16px; display:grid; place-items:center;
}
.flower{width:100%; max-width:320px; height:auto}
.stem{fill:none; stroke:#8FBF6A; stroke-width:4; stroke-linecap:round}
.leaf{fill:#A8CE5C}
.petal{transition:fill .3s ease}
.petal.is-open{animation:popIn .4s cubic-bezier(.2,1.6,.4,1)}
.petal-text{fill:#9AA6B2; font-size:7.4px; font-weight:800; transition:fill .3s ease}
.petal-text.is-open{fill:#3A2E24}
.flower-core{fill:#F5CE3E; stroke:#E0B32C; stroke-width:1.6}
.turn-arrow{fill:none; stroke:var(--orange); stroke-width:2.2; stroke-linecap:round}
.turn-arrowhead{fill:var(--orange)}

/* ── せんすいかん ── */
.sea-wrap{
  background:linear-gradient(180deg, #DCF0F7 0%, #8EC6DC 45%, #3E7F9E 100%);
  border:2px solid var(--line); border-radius:18px; padding:14px;
  display:grid; place-items:center;
}
.sea{width:100%; max-width:300px; height:auto}
.wave{fill:#F3FAFD}
.sea-path{fill:none; stroke:#FFFFFF; stroke-width:2.4; stroke-dasharray:4 5; stroke-linecap:round; opacity:.75}
.bubble{fill:#FFFFFF; opacity:.5}
.depth-body{transition:fill .3s ease}
.depth-text{fill:#7E8D99; font-size:7.4px; font-weight:800; transition:fill .3s ease}
.depth.is-open .depth-text{fill:#3A2E24}
.depth.is-open .depth-body{animation:popIn .38s cubic-bezier(.2,1.6,.4,1)}
.sub{transform-box:view-box; transform-origin:0 0; transition:transform .45s cubic-bezier(.4,.1,.3,1)}
.sub-body{fill:#F5CE3E}
.sub-win{fill:#FBF7EF}
.sub-fin{fill:#F0983C}
.chest-body{fill:#B9803E; stroke:#7E5527; stroke-width:1.2}
.chest-lid{fill:#D29A52; stroke:#7E5527; stroke-width:1.2; transform-box:view-box; transform-origin:50px 132px; transition:transform .4s ease}
.chest.is-open .chest-lid{transform:rotate(-26deg)}
.chest-lock{fill:#F5CE3E; stroke:#7E5527; stroke-width:1}
.shine-star{fill:#FFF0A8; animation:shine 1.3s ease-out infinite}
@keyframes shine{
  0%{transform:scale(.3); opacity:0}
  30%{opacity:1}
  100%{transform:scale(1.2); opacity:0}
}
.chest-shine path{transform-box:fill-box; transform-origin:center}

/* ── できたバッジ ── */
.done-badge{position:absolute; inset:0; display:grid; place-items:center; pointer-events:none;
  animation:pop .45s cubic-bezier(.2,1.5,.4,1)}
@keyframes pop{from{transform:scale(.5); opacity:0} to{transform:scale(1); opacity:1}}
.done-ring{width:210px; height:210px; animation:spin 11s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.done-star{fill:var(--amber)}
.done-core{fill:#FFFFFF}
.done-text{position:absolute; text-align:center; color:var(--ink)}
.done-word{display:block; font-size:30px; font-weight:800; letter-spacing:.04em}
.done-score{display:inline-block; margin-top:6px; padding:3px 12px;
  border:2.5px solid var(--ink); font-size:14px; font-weight:800}

/* ── 判定カード ── */
.judge-row{display:flex; gap:12px; margin-top:14px; align-items:stretch}
.judge{
  position:relative; width:86px; height:86px; flex:none; border-radius:18px;
  display:grid; place-items:center; border:3px solid var(--line); background:var(--paper);
}
.judge-name{font-size:30px; font-weight:800; color:var(--ink)}
.judge.is-empty .judge-name{color:#CDBFA9}
.judge.is-ok{border-color:var(--mint); animation:okPop .4s cubic-bezier(.2,1.6,.4,1)}
.judge.is-ok .judge-name{color:var(--mint)}
@keyframes okPop{from{transform:scale(.7)} to{transform:scale(1)}}
.judge.is-ng{border-color:var(--red); animation:ngShake .4s ease}
.judge.is-ng .judge-name{color:#B0A18E}
@keyframes ngShake{0%,100%{transform:translateX(0)} 25%{transform:translateX(-6px)} 75%{transform:translateX(6px)}}
.judge-cross{position:absolute; inset:0; width:100%; height:100%}
.judge-cross line{stroke:var(--red); stroke-width:11; stroke-linecap:round;
  stroke-dasharray:96; stroke-dashoffset:96; animation:draw .22s ease forwards}
.judge-cross line:last-child{animation-delay:.14s}
@keyframes draw{to{stroke-dashoffset:0}}
.heard{
  flex:1; padding:12px 14px; border-radius:14px;
  background:var(--paper); border:2px dashed var(--line);
  display:flex; flex-direction:column; justify-content:center; gap:6px; min-width:0;
}
.heard-label{font-size:11px; letter-spacing:.14em; color:var(--sub); font-weight:800}
.heard-text{font-size:18px; font-weight:800; color:var(--mint); word-break:break-all}

/* ── 操作 ── */
.notice{margin:10px 2px 14px; font-size:15px; font-weight:800; color:var(--sub)}
.notice.is-ng{color:var(--red)}
.controls{display:flex; gap:8px; align-items:stretch}
.mic{
  flex:1.3 1 0; min-width:0; padding:15px 10px; border:none; border-radius:999px; cursor:pointer;
  background:var(--amber); color:var(--ink); font-size:14px; font-weight:800; white-space:nowrap;
  box-shadow:0 3px 0 #DCA71F;
  display:flex; align-items:center; justify-content:center; gap:7px;
  transition:transform .12s ease, box-shadow .12s ease;
}
.mic:hover{transform:translateY(-2px); box-shadow:0 5px 0 #DCA71F}
.mic:active{transform:translateY(2px); box-shadow:0 1px 0 #DCA71F}
.mic:disabled{opacity:.5; cursor:not-allowed; transform:none}
.mic.is-live{background:var(--mint); color:#FFFFFF; box-shadow:0 3px 0 #23917F}
.mic-dot{width:9px; height:9px; flex:none; border-radius:50%; background:var(--ink); opacity:.3}
.mic.is-live .mic-dot{opacity:1; background:#FFFFFF; animation:blink 1s ease-in-out infinite}
@keyframes blink{50%{opacity:.3}}
.ghost{
  flex:1 1 0; min-width:0; padding:15px 8px; border-radius:999px; cursor:pointer;
  background:var(--paper); border:2px solid var(--line); color:var(--sub);
  font-size:13px; font-weight:800; white-space:nowrap;
}
.ghost:hover{border-color:var(--orange); color:var(--orange)}
.fallback-note{margin:12px 2px 0; font-size:13px; color:var(--red); line-height:1.7}

@media (max-width:420px){
  .controls{gap:6px}
  .mic{font-size:13px; padding:14px 8px}
  .ghost{font-size:12px; padding:14px 6px}
  .pin-svg{width:36px; height:92px}
  .pin{width:36px}
  .pin-label{width:27px; height:27px; font-size:12px; top:-10px}
  .judge{width:76px; height:76px}
  .judge-name{font-size:26px}
}
@media (prefers-reduced-motion:reduce){
  .app *{animation-duration:.01ms !important; transition-duration:.01ms !important}
}
