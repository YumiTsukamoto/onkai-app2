      setNotice("さいしょから もういちど！");
      idxRef.current = 1;
      setIdx(1);
      playNote(seq[0].note, true);
      await sleep(stepMs);
    } else {
      missRef.current += 1;
      setMisses(missRef.current);
      setJudge({
