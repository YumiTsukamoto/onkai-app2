    const r = recogRef.current;
    if (!r) return;
    if (wantRef.current) {
      wantRef.current = false;
      try {
        r.stop();
      } catch (e) {}
      setListening(false);
    } else {
      wantRef.current = true;
      try {
        r.start();
      } catch (e) {}
      setListening(true);
      setHeard("");
      setHint("");
    }
  }, []);
